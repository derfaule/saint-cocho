{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saint-cocho",
  "compatibility_date": "2026-10-06",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "saint-cocho-staging",
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": false,
          "head_sampling_rate": 1,
          "persist": true
        }
      },
      "assets": {
        "directory": ".",
    "not_found_handling": "single-page-application"
      }
    }
  }
}
